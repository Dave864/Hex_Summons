[layer_names]

3d_physics/layer_1="selector"
3d_physics/layer_2="map"
3d_physics/layer_3="player"
3d_physics/layer_4="enemy"
3d_physics/layer_5="action"
3d_physics/layer_6="mouse_blocker"

[mono]

project/assembly_name="Hex_Summons"

[physics]

common/enable_pause_aware_picking=true

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_environment="res://default_env.tres"
2d/snapping/use_gpu_pixel_snap=true
batching/options/use_batching_in_editor=false
