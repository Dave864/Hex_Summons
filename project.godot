_global_script_class_icons={
"Character": "",
"CoreStats": "",
"Encounter": "",
"EncounterState": "",
"EnemyCharacter": "",
"EnemyCharacterState": "",
"HexMap": "",
"MapTile": "",
"MousePosition": "",
"PlayerCharacter": "",
"PlayerCharacterState": "",
